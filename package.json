{
  "name": "ledgerly-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Ledgerly, a small and deliberately imperfect invoicing SaaS: the demo customer of Loopback.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "billing:tick": "tsx scripts/billing-tick.ts",
    "bugs:repro": "tsx scripts/reproduce-bugs.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
