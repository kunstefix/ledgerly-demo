# Demo values, published on purpose. Never reuse them with real data.
PORT=4000
DATABASE_URL=postgres://ledgerly:ledgerly_demo@localhost:5433/ledgerly
SESSION_SECRET=ledgerly-demo-session-secret-not-for-production

# Password of the read-only role Loopback uses (set in db/support.sql).
LOOPBACK_READER_PASSWORD=loopback_reader_demo

# Loopback settings. Usually written by Loopback's demo-setup to this file:
LOOPBACK_CONFIG_FILE=./config/loopback.json
# ...or set directly for standalone use (these override the file):
# LOOPBACK_API_PUBLIC_URL=http://localhost:3001
# LOOPBACK_WIDGET_CONNECTION_ID=
# LOOPBACK_IDENTITY_SECRET=
# LOOPBACK_HELP_CENTER_URL=
